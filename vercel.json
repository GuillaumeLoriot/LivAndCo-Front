{
    "version": 2,
    "installCommand": "npm ci",
    "buildCommand": "npm run build -- --configuration=production",
    "outputDirectory": "dist/liv-and-co/browser",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "http://51.38.35.219/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "http://51.38.35.219/uploads/:path*"
        },
        {
            "source": "/icons/:path*",
            "destination": "http://51.38.35.219/site-icons/:path*"
        },
        {
            "source": "/illustrations/:path*",
            "destination": "http://51.38.35.219/illustrations/:path*"
        },
        {
            "source": "/logos/:path*",
            "destination": "http://51.38.35.219/logos/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
